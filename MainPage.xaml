<?xml version="1.0" encoding="utf-8"?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:BookSearchApp.Views"
       x:Class="BookSearchApp.MainPage">
    <TabBar>
        <ShellContent Title="О программе" Route="AboutPage" ContentTemplate="{DataTemplate views:AboutPage}" />
        <ShellContent Title="Добавить книгу" Route="AddItem" ContentTemplate="{DataTemplate views:AddItem}" />
        <ShellContent Title="Каталог" Route="ItemPage" ContentTemplate="{DataTemplate views:ItemPage}" />
    </TabBar>
</Shell>